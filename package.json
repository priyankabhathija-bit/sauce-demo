{
  "name": "sauce-demo-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Focused Sauce Demo end-to-end assessment using Playwright and TypeScript",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
